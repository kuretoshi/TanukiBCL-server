{
	"compilerOptions": {
		"module": "commonjs",
		"noImplicitAny": true,
		"skipLibCheck": true,
		"sourceMap": true,
		"outDir": "dist",
		"baseUrl": ".",
		"esModuleInterop": true,
		"paths": {
			"*": [
				"node_modules/*"
			]
		}
	},
	"include": [
		"src/**/*", "types/node-turn/index.d.ts"
	]
}
