doctype html
html(lang="ja")
	head
		title TanukiBCL Server
		meta(charset="utf-8")
		meta(name="viewport", content="width=device-width, initial-scale=1")
		link(rel="icon", href="/public/logo.png", type="image/png")
		meta(property='og:title' content='TanukiBCL Server')
		meta(property='og:description' content='Among Us 近接ボイスチャット用シグナリングサーバー')
		meta(property='og:image' content='/public/logo.png')
		link(rel='stylesheet', href='/public/styles.css')


	body
		img(src="/public/logo.png", alt="TanukiBCL Server")
		h1 TanukiBCL Server
		#crewinfo

			p このサーバーは次のURLで稼働しています。
			br
			b #{address}
			p 現在の接続ユーザー数: #{connectionCount}
			p 公開ロビー数: #{lobbiesCount}
			<hr>
			p
				a(href="https://github.com/OhMyGuus/BetterCrewLink/releases/latest", target="_blank", rel="noopener noreferrer")
					| BetterCrewLink をダウンロード
			<hr>
			p TanukiBCL / BetterCrewLink のサーバーURLに、この公開URLを設定してください。
		
		#background-container
			#stars
			#stars2
			#stars3
