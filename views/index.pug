doctype html
html(lang="ja")
	head
		title TanukiBCL Server
		meta(charset="utf-8")
		meta(name="viewport", content="width=device-width, initial-scale=1")
		link(rel="icon", href="/public/icon.png", type="image/png")
		meta(property='og:title' content='TanukiBCL Server')
		meta(property='og:description' content='Among Us 近接ボイスチャット用シグナリングサーバー')
		meta(property='og:image' content='/public/icon.png')
		link(rel='stylesheet', href='/public/styles.css')


	body
		canvas#stars
		script.
			(function () {
				var canvas = document.getElementById('stars');
				var ctx = canvas.getContext('2d');
				var stars = [];
				var count = 180;

				function resize() {
					canvas.width = window.innerWidth;
					canvas.height = window.innerHeight;
				}

				for (var i = 0; i < count; i++) {
					stars.push({
						x: Math.random(),
						y: Math.random(),
						r: Math.random() * 1.3 + 0.2,
						speed: Math.random() * 0.00008 + 0.00002,
						base: Math.random() * 0.5 + 0.3,
						phase: Math.random() * Math.PI * 2,
					});
				}

				var t = 0;
				function draw() {
					t += 0.02;
					ctx.clearRect(0, 0, canvas.width, canvas.height);
					for (var j = 0; j < stars.length; j++) {
						var s = stars[j];
						var opacity = s.base + 0.25 * Math.sin(t + s.phase);
						ctx.beginPath();
						ctx.arc(s.x * canvas.width, s.y * canvas.height, s.r, 0, Math.PI * 2);
						ctx.fillStyle = 'rgba(255,255,255,' + opacity + ')';
						ctx.fill();
						s.y += s.speed;
						if (s.y > 1) {
							s.y = 0;
							s.x = Math.random();
						}
					}
					requestAnimationFrame(draw);
				}

				resize();
				window.addEventListener('resize', resize);
				draw();
			})();
		main.container
			img.logo(src="/public/icon.png", alt="TanukiBCL")
			.card
				.stat
					span.label サーバーアドレス
					span.value.value--url #{address}
				.stat
					span.label 接続ユーザー数
					span.value #{connectionCount}
				.stat
					span.label 公開ロビー数
					span.value #{lobbiesCount}
			.links
				a(href="https://github.com/kuretoshi/TanukiBCL/releases", target="_blank", rel="noopener noreferrer")
					svg(width="15", height="15", viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2", stroke-linecap="round", stroke-linejoin="round", aria-hidden="true")
						path(d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4")
						polyline(points="7 10 12 15 17 10")
						line(x1="12", y1="15", x2="12", y2="3")
					| ダウンロード
				a(href="https://tanukibcl.kuretoshi.work/", target="_blank", rel="noopener noreferrer")
					svg(width="15", height="15", viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2", stroke-linecap="round", stroke-linejoin="round", aria-hidden="true")
						circle(cx="12", cy="12", r="10")
						line(x1="2", y1="12", x2="22", y2="12")
						path(d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z")
					| ウェブ版
